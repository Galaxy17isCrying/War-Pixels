# ==============================================================================
# War Pixels — Environment Configuration Example
# Copy this file to .env and fill in your values.
# The game uses SQLite by default; MySQL mirroring is entirely optional.
# ==============================================================================

# ── MySQL Mirror (optional) ───────────────────────────────────────────────────
# Set to "true" to enable MySQL mirroring alongside local SQLite saves.
# Leave unset or "false" to use SQLite only (default, offline-safe).
OVERHEAD_OPS_MYSQL_ENABLED=false

OVERHEAD_OPS_MYSQL_HOST=127.0.0.1
OVERHEAD_OPS_MYSQL_PORT=3306
OVERHEAD_OPS_MYSQL_DATABASE=overhead_ops
OVERHEAD_OPS_MYSQL_USER=root
OVERHEAD_OPS_MYSQL_PASSWORD=

# ── API account database and GitHub OAuth ────────────────────────────────────
# A separate SQLite database stores GitHub account IDs and hashed session/state
# tokens. OAuth credentials and session secrets are never written to that DB.
WARPIXELS_AUTH_DB=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/github/callback
WARPIXELS_COOKIE_SECURE=false

# Never put real credentials in this example. Keep them in an ignored .env file
# or in your deployment provider's secret store. Do not commit .env.
